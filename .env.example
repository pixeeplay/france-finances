# Database (required for backend features, optional for dev/localStorage mode)
DATABASE_URL=postgres://tronco:tronco_secret@localhost:5432/tronconneuse
DB_POOL_MAX=10

# Auth.js (NextAuth v5)
AUTH_SECRET=your-random-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Admin (/pixee-admin, /api/analytics/dashboard, /api/analytics/purge)
# Emails autorises, separes par des virgules (comparaison insensible a la casse).
# Vide ou absent = aucun admin (acces refuse a tout le monde).
ADMIN_EMAILS=

# Acces programmatique aux routes analytics admin (cron, scripts) :
# header x-analytics-secret ou ?secret=. Vide = desactive.
# ANALYTICS_SECRET=your-secret-here
